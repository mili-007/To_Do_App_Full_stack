// Prisma schema for PostgreSQL version of the app.
//
// Notes:
// - This mirrors the existing MongoDB/Mongoose models (User/Project/Category/Todo/Comment)
// - IDs are String so we can keep returning `_id` to the frontend (mapping `id` -> `_id` in controllers)
// - Many-to-many relationships are implemented with explicit join tables for clarity and control.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  low
  medium
  high
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects   Project[]
  categories Category[]
  todos      Todo[]    @relation("TodosOwned")
  comments   Comment[]

  // Shared todos (many-to-many)
  sharedTodos TodoShare[]
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#3B82F6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  todos  Todo[]

  @@index([userId, createdAt(sort: Desc)])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#10B981")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  todos TodoCategory[]

  @@unique([userId, name])
  @@index([userId, name])
}

model Todo {
  id          String    @id @default(cuid())
  title       String
  description String?
  completed   Boolean   @default(false)
  priority    Priority  @default(medium)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId String
  user   User   @relation("TodosOwned", fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  categories  TodoCategory[]
  sharedWith  TodoShare[]
  comments    Comment[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([projectId])
}

model TodoCategory {
  todoId     String
  categoryId String

  todo     Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([todoId, categoryId])
  @@index([categoryId])
}

model TodoShare {
  todoId String
  userId String

  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([todoId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  todoId String
  todo   Todo   @relation(fields: [todoId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([todoId, createdAt])
  @@index([userId])
}

